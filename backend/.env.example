PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development   # use "production" when deployed (turns on secure cookies)

# Public base URL, used for links inside emails
# APP_URL=https://pulse.example.com

# Email alerts + weekly digest (optional). Without SMTP_HOST, alerts are
# recorded in the notifications table as "skipped" and nothing is sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="PULSE <alerts@example.com>"

# Local dev only: allow monitoring localhost / private-network addresses
# ALLOW_PRIVATE_TARGETS=true

# Behind a reverse proxy (Cloudflare, Nginx, ...): number of proxy hops, so
# rate limiting sees the real client IP. Leave unset when not proxied.
# TRUST_PROXY=1

# Only needed if another website's JavaScript must call this API with cookies.
# The bundled frontend is same-origin and does not need it.
# CORS_ORIGINS=https://app.example.com

# Consecutive failed checks before an incident opens and an alert is sent (default 2)
# FAILURE_THRESHOLD=2
